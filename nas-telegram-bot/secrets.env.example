# Copy to secrets.env on the NAS, fill in, then: chmod 600 secrets.env
# Never commit secrets.env, never paste these values into a chat.

# Telegram: token from @BotFather; your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Claude: run `claude setup-token` once (see README) and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=

# Smokeball Developer Console > Apps > your app, and > API > AU API Key
SMOKEBALL_CLIENT_ID=
SMOKEBALL_CLIENT_SECRET=
SMOKEBALL_API_KEY=
